<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.QuizApp_Adnan" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnPrimary">@color/colorButtonText</item>
    </style>

    <!-- Bottom nav pill text styles -->
    <style name="NavTextActive" parent="@style/TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#4A90D9</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NavTextInactive" parent="@style/TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#9CA3AF</item>
    </style>

</resources>
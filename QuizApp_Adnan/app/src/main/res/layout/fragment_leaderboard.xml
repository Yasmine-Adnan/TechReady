<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <!-- ════════════════════════════════════════════ -->
        <!--  SECTION 1 — DÉFI HEBDOMADAIRE              -->
        <!-- ════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/challengeCardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_challenge_card"
                android:padding="16dp">

                <!-- Top row: icon + title + badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Icône cible -->
                    <TextView
                        android:id="@+id/challengeEmojiText"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_countdown_block"
                        android:gravity="center"
                        android:text="🎯"
                        android:textSize="20sp" />

                    <!-- Titre -->
                    <TextView
                        android:id="@+id/challengeTitleText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="DÉFI HEBDOMADAIRE"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <!-- Badge +50 pts -->
                    <TextView
                        android:id="@+id/challengePointsChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_points_badge"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="+50 pts"
                        android:textColor="#6A1B9A"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Description -->
                <TextView
                    android:id="@+id/challengeDescText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Réussir 3 entretiens techniques cette semaine avec plus de 80% de score."
                    android:textColor="#EDE7F6"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4" />

                <!-- Séparateur -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#33FFFFFF"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp" />

                <!-- Label countdown -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FIN DU DÉFI DANS :"
                    android:textColor="#EDE7F6"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />

                <!-- Blocs countdown -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- JOURS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvCountdownDays"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_countdown_block"
                            android:gravity="center"
                            android:text="07"
                            android:textColor="#5C6BC0"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="JOURS"
                            android:textColor="#EDE7F6"
                            android:textSize="9sp"
                            android:letterSpacing="0.06" />
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=":" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"
                        android:paddingBottom="12dp" />

                    <!-- HEURES -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvCountdownHours"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_countdown_block"
                            android:gravity="center"
                            android:text="00"
                            android:textColor="#5C6BC0"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="HEURES"
                            android:textColor="#EDE7F6"
                            android:textSize="9sp"
                            android:letterSpacing="0.06" />
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=":" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"
                        android:paddingBottom="12dp" />

                    <!-- MINS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvCountdownMins"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_countdown_block"
                            android:gravity="center"
                            android:text="00"
                            android:textColor="#5C6BC0"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="MINS"
                            android:textColor="#EDE7F6"
                            android:textSize="9sp"
                            android:letterSpacing="0.06" />
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=":" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"
                        android:paddingBottom="12dp" />

                    <!-- SECS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvCountdownSecs"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_countdown_block"
                            android:gravity="center"
                            android:text="00"
                            android:textColor="#5C6BC0"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="SECS"
                            android:textColor="#EDE7F6"
                            android:textSize="9sp"
                            android:letterSpacing="0.06" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ════════════════════════════════════════════ -->
        <!--  SECTION 2 — TOP 3 PODIUM                   -->
        <!-- ════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Titre section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆  TOP 3"
                    android:textColor="#1A1D3A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="16dp" />

                <!-- Podium row: 2nd | 1st | 3rd -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <!-- ── 2ème place (gauche) ── -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_avatar_circle"
                            android:gravity="center"
                            android:text="👤"
                            android:textSize="26sp" />

                        <TextView
                            android:id="@+id/tvPodium2Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="—"
                            android:textColor="#1A1D3A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/tvPodium2Points"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 pts"
                            android:textColor="#9EA3C0"
                            android:textSize="12sp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/circle_background_silver"
                            android:gravity="center"
                            android:layout_marginTop="6dp"
                            android:text="2"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- ── 1ère place (centre, surélevé) ── -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_profile_stat_card"
                        android:padding="10dp"
                        android:layout_marginBottom="0dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👑"
                            android:textSize="24sp"
                            android:gravity="center"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/bg_avatar_circle"
                            android:gravity="center"
                            android:text="👤"
                            android:textSize="34sp" />

                        <TextView
                            android:id="@+id/tvPodium1Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="—"
                            android:textColor="#1A1D3A"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/tvPodium1Points"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 pts"
                            android:textColor="#5C6BC0"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_background_gold"
                            android:gravity="center"
                            android:layout_marginTop="8dp"
                            android:text="1"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- ── 3ème place (droite) ── -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_avatar_circle"
                            android:gravity="center"
                            android:text="👤"
                            android:textSize="26sp" />

                        <TextView
                            android:id="@+id/tvPodium3Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="—"
                            android:textColor="#1A1D3A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/tvPodium3Points"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 pts"
                            android:textColor="#9EA3C0"
                            android:textSize="12sp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/circle_background_bronze"
                            android:gravity="center"
                            android:layout_marginTop="6dp"
                            android:text="3"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ════════════════════════════════════════════ -->
        <!--  SECTION 3 — LEADERBOARD CAMPUS GPS         -->
        <!-- ════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/campusCardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header: icône rose + texte -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_campus_icon_circle"
                        android:gravity="center"
                        android:text="📍"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/campusSectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Leaderboard Campus"
                            android:textColor="#1A1D3A"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/campusSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Compare-toi aux étudiants de ton campus"
                            android:textColor="#9EA3C0"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Bouton outlined GPS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetectCampus"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:text="Détecter mon campus"
                    android:textColor="#5C6BC0"
                    android:textSize="14sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@android:drawable/ic_menu_mylocation"
                    app:iconGravity="start"
                    app:iconTint="#5C6BC0"
                    app:strokeColor="#C5CAE9"
                    app:strokeWidth="1.5dp"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="12dp" />

                <ProgressBar
                    android:id="@+id/campusProgressBar"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/campusResultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#1A1D3A"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ════════════════════════════════════════════ -->
        <!--  SECTION 4 — CLASSEMENT GLOBAL              -->
        <!-- ════════════════════════════════════════════ -->

        <!-- Titre section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="CLASSEMENT GLOBAL"
            android:textColor="#9EA3C0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.10" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/leaderboardRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            tools:listitem="@layout/item_leaderboard" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF0F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ══════════════════════════════════════════ -->
        <!--  TOP BAR  ←  Profil  ⚙                    -->
        <!-- ══════════════════════════════════════════ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#EEF0F8">

            <ImageButton
                android:id="@+id/ibProfileBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#5C6BC0"
                android:contentDescription="Retour" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Profil"
                android:textColor="#1A1D3A"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <ImageButton
                android:id="@+id/ibProfileSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_preferences"
                android:tint="#5C6BC0"
                android:contentDescription="Paramètres" />
        </RelativeLayout>

        <!-- ══════════════════════════════════════════ -->
        <!--  CARTE PROFIL (header + avatar + nom)      -->
        <!-- ══════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Gradient header lavande -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:background="@drawable/bg_profile_header" />

                <!-- Avatar centré qui chevauche le gradient -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="-50dp"
                    android:paddingBottom="20dp">

                    <!-- Avatar cliquable avec overlay stylo -->
                    <FrameLayout
                        android:id="@+id/profileImageContainer"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:clickable="true"
                        android:focusable="true">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/profileImage"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:src="@drawable/baseline_person_28"
                            app:civ_border_color="#FFFFFF"
                            app:civ_border_width="3dp" />

                        <!-- Badge stylo édition (bas droite) -->
                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_profile_badge_chip"
                            android:text="✏️"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:elevation="2dp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/profileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#1A1D3A"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        tools:text="ys" />

                    <TextView
                        android:id="@+id/profileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#9EA3C0"
                        android:textSize="13sp"
                        tools:text="ys@gmail.com" />

                    <!-- Badge niveau "Senior Student" -->
                    <TextView
                        android:id="@+id/tvProfileBadgeChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="Senior Student"
                        android:textColor="#5C6BC0"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_profile_badge_chip" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══════════════════════════════════════════ -->
        <!--  CARTE PARCOURS                            -->
        <!-- ══════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Titre Parcours -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎓"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Parcours"
                        android:textColor="#1A1D3A"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Filière -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filière"
                    android:textColor="#9EA3C0"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/profileFiliere"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="14dp"
                    android:textColor="#1A1D3A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Développement &amp; Systèmes d'Information" />

                <!-- Séparateur -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEF0F8"
                    android:layout_marginBottom="14dp" />

                <!-- Spécialité -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spécialité"
                    android:textColor="#9EA3C0"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/profileSpecialite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#1A1D3A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Mobile (Android, iOS, Flutter)" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══════════════════════════════════════════ -->
        <!--  STATS : Niveau + XP (deux mini-cartes)    -->
        <!-- ══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp">

            <!-- Niveau -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_profile_stat_card"
                        android:text="☆"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:textColor="#5C6BC0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Niveau"
                        android:textColor="#9EA3C0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/profileLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#1A1D3A"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        tools:text="Niveau 1" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- XP Total -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_profile_stat_card"
                        android:text="⚡"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:textColor="#5C6BC0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="XP Total"
                        android:textColor="#9EA3C0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/profileXp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#1A1D3A"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        tools:text="0 XP" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ══════════════════════════════════════════ -->
        <!--  CARTE MES BADGES                          -->
        <!-- ══════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/badgesCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Header badges -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏆"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Mes badges"
                            android:textColor="#1A1D3A"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBadgeCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="2/10"
                        android:textColor="#5C6BC0"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- État vide -->
                <TextView
                    android:id="@+id/noBadgesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:text="Complète des sessions pour débloquer tes premiers badges !"
                    android:textAlignment="center"
                    android:textColor="#9EA3C0"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Grille de badges (RecyclerView en grille) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/badgesRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:listitem="@layout/item_badge" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══════════════════════════════════════════ -->
        <!--  CARTE LOCALISATION — Ma position GPS      -->
        <!-- ══════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- En-tête : icône GPS + titre -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍"
                        android:textSize="20sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ma localisation"
                        android:textColor="#1A1D3A"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Nom de la ville détectée -->
                <TextView
                    android:id="@+id/tvCityName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ville non détectée"
                    android:textColor="#5C6BC0"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />

                <!-- Bouton Détecter -->
                <Button
                    android:id="@+id/btnDetectLocation"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🔍  Détecter ma ville"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_gradient"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="12dp" />

                <!-- MapView (caché tant que la position n'est pas détectée) -->
                <com.google.android.gms.maps.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:visibility="gone" />

                <!-- Bouton Modifier (relancer GPS) -->
                <Button
                    android:id="@+id/btnRefreshLocation"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="🔄  Modifier"
                    android:textColor="#5C6BC0"
                    android:textSize="13sp"
                    android:background="@drawable/bg_button_outlined"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══════════════════════════════════════════ -->
        <!--  BOUTON : Modifier mon profil              -->
        <!-- ══════════════════════════════════════════ -->
        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="20dp"
            android:text="✏  Modifier mon profil"
            android:textColor="#2E7D32"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_edit_profile"
            android:backgroundTint="@null"
            android:stateListAnimator="@null" />

        <!-- ══════════════════════════════════════════ -->
        <!--  BOUTON : Se déconnecter                   -->
        <!-- ══════════════════════════════════════════ -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:text="↪  Se déconnecter"
            android:textColor="#C62828"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_logout"
            android:backgroundTint="@null"
            android:stateListAnimator="@null" />

    </LinearLayout>
</ScrollView>

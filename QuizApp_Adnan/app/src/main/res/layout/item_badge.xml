<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <!-- Icône du badge dans un carré arrondi -->
    <FrameLayout
        android:id="@+id/badgeIconContainer"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_badge_item">

        <TextView
            android:id="@+id/badgeEmoji"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="30sp"
            tools:text="💀" />
    </FrameLayout>

    <!-- Nom du badge -->
    <TextView
        android:id="@+id/badgeName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#6B6E8A"
        android:textSize="12sp"
        android:textAlignment="center"
        android:maxWidth="80dp"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="Survivant" />

</LinearLayout>
